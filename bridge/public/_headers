# Cloudflare Pages headers.
# Files in public/ are copied to the build root, so this lands at dist/_headers.

# Vite fingerprints these, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Large, rarely-changing binaries.
/models/*
  Cache-Control: public, max-age=31536000, immutable
/draco/*
  Cache-Control: public, max-age=31536000, immutable
/matcaps/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always revalidate so a deploy takes effect at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
